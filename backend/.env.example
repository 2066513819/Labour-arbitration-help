# 劳动仲裁辅助系统 - 环境变量配置模板
# 使用方式：复制为 .env 并填入真实值

# ============================================
# 运行环境（development / production）
# ============================================
ENVIRONMENT=development

# ============================================
# 数据库配置（开发环境使用 SQLite）
# ============================================
DATABASE_URL=sqlite:///./labor_arb.db

# ============================================
# JWT 密钥（生产环境必须修改为强随机值）
# 生成命令：python -c "import secrets; print(secrets.token_hex(32))"
# ============================================
# 开发环境留空即可，系统会自动生成随机密钥
# SECRET_KEY=

# ============================================
# 腾讯元器智能体 API（智能对话）
# ============================================
YUANQI_API_BASE=https://yuanqi.tencent.com/openapi/v1/agent/chat/completions
YUANQI_API_KEY=your_yuanqi_api_key_here
YUANQI_AGENT_ID=your_agent_id_here

# ============================================
# 文书起草智能体 API（图片上传）
# ============================================
DOCUMENT_AGENT_ID=your_document_agent_id_here
DOCUMENT_AGENT_API_KEY=your_document_agent_api_key_here

# ============================================
# 文书起草工作流 API
# ============================================
WORKFLOW_AGENT_ID=your_workflow_agent_id_here
WORKFLOW_API_KEY=your_workflow_api_key_here
WORKFLOW_API_BASE=https://yuanqi.tencent.com/openapi/v1

# ============================================
# 验证码服务
# ============================================
# 开发环境固定验证码（留空自动生成随机码）
# DEV_SMS_CODE=

# ── 邮箱验证码（SMTP，推荐，零资质门槛） ──
# QQ邮箱获取授权码：QQ邮箱 → 设置 → 账户 → POP3/SMTP服务 → 生成授权码
# 163邮箱获取授权码：163邮箱 → 设置 → POP3/SMTP/IMAP → 开启并获取授权码
EMAIL_SMTP_HOST=smtp.qq.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_USER=your_email@qq.com
EMAIL_SMTP_PASS=your_authorization_code
EMAIL_SENDER_NAME=劳动仲裁帮

# ── 腾讯云 SMS（可选，需企业资质审核） ──
SMS_SECRET_ID=your_sms_secret_id
SMS_SECRET_KEY=your_sms_secret_key
SMS_SDK_APP_ID=your_sdk_app_id
SMS_SIGN_NAME=your_sign_name
SMS_TEMPLATE_ID=your_template_id
SMS_REGION=ap-guangzhou

# ============================================
# CORS 允许的前端来源（多个用逗号分隔）
# ============================================
CORS_ORIGINS=http://localhost:5173

# ============================================
# 腾讯云COS配置（可选，用于文件上传）
# ============================================
# COS_SECRET_ID=your_cos_secret_id
# COS_SECRET_KEY=your_cos_secret_key
# COS_BUCKET=your_bucket_name
# COS_REGION=ap-guangzhou

# ============================================
# OCR 配置（可选，用于证据图片识别）
# ============================================
# OCR_API_BASE=
# OCR_API_KEY=

# ============================================
# 得理法律 API（可选）
# ============================================
# DELI_API_BASE=
# DELI_API_KEY=
